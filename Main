-- // ESP Loop & Logic //
local CustomDrawing = loadstring(game:HttpGet("https://raw.githubusercontent.com/Pumpuma/UKI/main/Mycustomdrawing.lua"))()

local maxUpdateRate = settings.esp.UpdateSpeed
local minUpdateRate = 5
local minUpdateInterval = 1 / maxUpdateRate
local maxUpdateInterval = 1 / minUpdateRate
local updateInterval = minUpdateInterval
local lastUpdateTime = tick()
local lastFrameTime = tick()
local fpsDropThreshold = 60

local function getRainbow()
    local time = tick()
    local r = math.sin(time * 0.5) * 0.5 + 0.5
    local g = math.sin(time * 0.5 + 2) * 0.5 + 0.5
    local b = math.sin(time * 0.5 + 4) * 0.5 + 0.5
    return Color3.fromRGB(r * 255, g * 255, b * 255)
end

local screenGui = Instance.new("ScreenGui")
screenGui.Parent = CoreGui
screenGui.Name = "ESPHolder"

local function updateDrawings()
    screenGui:ClearAllChildren()

    for _, model in pairs(workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            local rootPart = model.HumanoidRootPart
            local head = model:FindFirstChild("Head")
            if not head then continue end

            local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
            local teamTag = head:FindFirstChild("Teamtag")
            local teamEnabled = teamTag and teamTag.Enabled or false
            local nameTag = head:FindFirstChild("Nametag") and head.Nametag:FindFirstChild("tag")
            local playerName = (nameTag and nameTag.Text ~= "") and nameTag.Text or "Player"
            local isBot = (playerName == "Shylou2644")
            local weapon = PlayerWeapon(model)
            local armor = getHighestPriorityArmor(model:FindFirstChild("Armor"))
            local shouldApplyHitbox = not (settings.combat.HitboxTeam and teamEnabled)
            
            if onScreen and settings.esp.Enabled and (not settings.esp.TeamCheck or not teamEnabled) and (not settings.esp.SleepCheck or not IsSleeping(model)) and (not settings.esp.NoBot or not isBot) then
                local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
                local scaledDistance = math.ceil(distance / 3.2)
                local scale = 1 / (distance * math.tan(math.rad(Camera.FieldOfView * 0.5))) * 25
                local width, height = math.floor(45 * scale), math.floor(72 * scale)

                width = math.max(width, 1)
                height = math.max(height, 1)

                local startPos = Vector2.new(Camera.ViewportSize.X / 2, 0)
                local endPos = Vector2.new(screenPos.X, screenPos.Y - height / 2)

                if settings.esp.Tracer then CustomDrawing.new("Line").create(screenGui, startPos, endPos, getRainbow(), 1) end
                if settings.esp.Box then CustomDrawing.new("Square").create(screenGui, Vector2.new(screenPos.X, screenPos.Y), width, height, getRainbow(), getRainbow(), 1) end
                if settings.esp.Name then CustomDrawing.new("Text").create(screenGui, Vector2.new(screenPos.X, screenPos.Y - height / 2 - 10), playerName, getRainbow()) end
                if settings.esp.Weapon then CustomDrawing.new("Text").create(screenGui, Vector2.new(screenPos.X, screenPos.Y + height / 2 + 15), weapon, getRainbow()) end
                if settings.esp.Armor then CustomDrawing.new("Text").create(screenGui, Vector2.new(screenPos.X, screenPos.Y + height / 2 + 30), armor, getRainbow()) end
                if settings.esp.Distance then CustomDrawing.new("Text").create(screenGui, Vector2.new(screenPos.X, screenPos.Y + height / 2 + 45), tostring(scaledDistance) .. "m", getRainbow()) end 

                if settings.combat.HitboxEnabled and shouldApplyHitbox then
                    for _, part in ipairs({"Head", "Torso"}) do
                        if model:FindFirstChild(part) and part ~= settings.combat.HitPart then
                            resetPartSize(model:FindFirstChild(part))
                        end
                    end
                    local hitPartInstance = model:FindFirstChild(settings.combat.HitPart)
                    if hitPartInstance then
                        if not originalSizes[hitPartInstance] then originalSizes[hitPartInstance] = hitPartInstance.Size end
                        hitPartInstance.Transparency = 0.50
                        hitPartInstance.CanCollide = false
                        hitPartInstance.Size = Vector3.new(settings.combat.HitboxSize, settings.combat.HitboxSize, settings.combat.HitboxSize)
                    end
                end
            end
        end
    end
end

-- // Main Loop //
RunService.RenderStepped:Connect(function()
    -- 1. Silent Aim Visuals
    local center = Camera.ViewportSize / 2
    local baseRadius = settings.silentAim.Fov.Radius
    local fovScale = baseRadius * (math.tan(math.rad(50)) / math.tan(math.rad(Camera.FieldOfView))) ^ 0.35

    if settings.silentAim.Fov.Visible and settings.silentAim.Enabled then
        fovCircle.Visible = true
        fovCircle.Position = center
        fovCircle.Radius = fovScale
        fovCircle.Color = settings.silentAim.Fov.Color
    else
        fovCircle.Visible = false
    end

    local saTarget, _ = getClosestPlayer()
    if saTarget then
        local screenPos, onScreen = Camera:WorldToViewportPoint(saTarget.Position)
        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
        if settings.silentAim.Snapline.Enabled and onScreen then
            saSnapLine.Visible = true
            saSnapLine.From = center
            saSnapLine.To = screenVec
            saSnapLine.Color = settings.silentAim.Snapline.Color
        else
            saSnapLine.Visible = false
        end

        if settings.silentAim.Highlight.Enabled then
            HL.Adornee = saTarget.Parent
            HL.OutlineColor = settings.silentAim.Highlight.Color
            HL.FillTransparency = settings.silentAim.Highlight.FillTransparency
        else
            HL.Adornee = nil
        end
    else
        saSnapLine.Visible = false
        HL.Adornee = nil
    end

    -- 2. ESP Loop (Frame Time Managed)
    local currentTime = tick()
    local frameTime = currentTime - lastFrameTime
    lastFrameTime = currentTime

    local desiredInterval = 1 / settings.esp.UpdateSpeed
    local fps = 1 / frameTime

    if fps < fpsDropThreshold then
        local fpsDropFactor = math.clamp((fpsDropThreshold - fps) / (fpsDropThreshold - minUpdateRate), 0, 1)
        updateInterval = math.max(minUpdateInterval, desiredInterval + fpsDropFactor * (maxUpdateInterval - desiredInterval))
    else
        updateInterval = minUpdateInterval
    end

    if currentTime - lastUpdateTime >= updateInterval then
        lastUpdateTime = currentTime
        updateDrawings()
    end
end)
