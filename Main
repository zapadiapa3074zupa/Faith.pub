    -- Stub for the ESP/Hitbox logic
end

local Items = game:GetService("ReplicatedStorage"):WaitForChild("HandModels")
for _, v in pairs(Items:GetChildren()) do
    v:SetAttribute("RealName", v.Name)
end

local originalSizes = {}

local function resetPartSize(part)
    if part and originalSizes[part] then
        part.Size = originalSizes[part]
        part.Transparency = 0
        part.CanCollide = true
    end
end

local function PlayerWeapon(Player)
    local Model = Player:FindFirstChildOfClass("Model")
    return Model and Model:GetAttribute("RealName") or "None"
end

local SleepAnimationId = "rbxassetid://13280887764"
function IsSleeping(Player)
    local Animations = Player.AnimationController:GetPlayingAnimationTracks()
    for _, v in pairs(Animations) do
        if v.IsPlaying and v.Animation.AnimationId == SleepAnimationId then
            return true
        end
    end
    return false
end

local function getHighestPriorityArmor(armorFolder)
    local priorityLevels = { Wood = 1, Riot = 2, Iron = 3, Steel = 4, Military = 5 }
    local priorityNames = { [1] = "Wood", [2] = "Riot", [3] = "Iron", [4] = "Steel", [5] = "Military" }
    
    local highestPriority = 0
    local armorType = ""
    local miscCount = 0
    local hasMisc = false
    local onlyMisc = true

    if not armorFolder then return "No Armor" end

    for _, item in pairs(armorFolder:GetChildren()) do
        local armorName = item.Name
        local currentPriority = 0

        if armorName:find("Wood") then currentPriority = priorityLevels.Wood
        elseif armorName:find("Riot") then currentPriority = priorityLevels.Riot
        elseif armorName:find("Iron") then currentPriority = priorityLevels.Iron
        elseif armorName:find("Steel") then currentPriority = priorityLevels.Steel
        elseif armorName == "CombatHelmet" or armorName == "KevlarVest" then currentPriority = priorityLevels.Military
        end
        
        if currentPriority > highestPriority then
            highestPriority = currentPriority
            armorType = priorityNames[highestPriority]
            onlyMisc = false
        end
    end

    local miscItemsList = { "SmallBackpack", "Sling", "Rebreather", "CamoShirt", "CamoPants", "PoliceShirt", "PolicePants", "Boots" }
    for _, item in pairs(armorFolder:GetChildren()) do
        if item:IsA("Folder") and table.find(miscItemsList, item.Name) then
            hasMisc = true
            miscCount = miscCount + 1
        end
    end

    if onlyMisc and hasMisc then return "Misc+" .. tostring(miscCount)
    elseif not onlyMisc and hasMisc then return armorType .. "+" .. tostring(miscCount)
    elseif not onlyMisc then return armorType
    else return "No Armor" end
end

