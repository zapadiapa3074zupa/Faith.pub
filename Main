-- [[ 1. MASTER SETTINGS ]]
local settings = {
    esp_Enabled = true,
    esp_Box = true,
    esp_Skeleton = true,
    esp_Tracer = true,
    esp_Name = true,
    esp_Distance = true,
    esp_Weapon = true,
    esp_Armor = true,
    esp_SleepCheck = true,
    esp_NoBot = false,
    esp_MaxDistance = 5000,
    combat_HitboxEnabled = true,
    combat_HitPart = "Head",
    combat_HitboxSize = 8.4,
    combat_SilentAim = true,
    combat_ShowFOV = true,
    combat_FovSize = 67,
    misc_ArmorInspector = false,
    misc_DotCrosshair = true,
    ore_Enabled = false,
    ore_MaxDistance = 1200,
    ore_ShowStone = false,
    ore_ShowIron = false,
    ore_ShowNitrate = false,
    ore_Chams = false
}

-- [[ 2. SERVICES & GLOBALS ]]
local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    CoreGui = game:GetService("CoreGui"),
    ReplicatedStorage = game:GetService("ReplicatedStorage"),
    Workspace = game:GetService("Workspace")
}
local camera = workspace.CurrentCamera
local LocalPlayer = Services.Players.LocalPlayer

local skeleton_order = {
    ["LeftFoot"] = "LeftLowerLeg", ["LeftLowerLeg"] = "LeftUpperLeg", ["LeftUpperLeg"] = "LowerTorso",
    ["RightFoot"] = "RightLowerLeg", ["RightLowerLeg"] = "RightUpperLeg", ["RightUpperLeg"] = "LowerTorso",
    ["LeftHand"] = "LeftLowerArm", ["LeftLowerArm"] = "LeftUpperArm", ["LeftUpperArm"] = "Torso",
    ["RightHand"] = "RightLowerArm", ["RightLowerArm"] = "RightUpperArm", ["RightUpperArm"] = "Torso",
    ["LowerTorso"] = "Torso", ["Torso"] = "Head"
}

local ore_id = {
    Stone = "rbxassetid://12939036056",
    NitrateColor = Color3.fromRGB(248, 248, 248),
    IronColor = Color3.fromRGB(199, 172, 120)
}

-- [[ 3. LIBRARIES ]]
local DrRayLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/AZYsGithub/DrRay-UI-Library/main/DrRay.lua"))()
local DrawingLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Pumpuma/UKI/main/Mycustomdrawing.lua"))()
local window = DrRayLibrary:Load("chino.pubv2", "Default")

-- [[ 4. SILENT AIM LOGIC ]]
local players = {}
local createProjectile
local validGuns = {"AR15", "C9", "Crossbow", "Bow", "EnergyRifle", "GaussRifle", "HMAR", "KABAR", "LeverActionRifle", "M4A1", "PipePistol", "PipeSMG", "PumpShotgun", "SCAR", "SVD", "USP9", "UZI", "Blunderbuss"}

local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5; fovCircle.NumSides = 64; fovCircle.Filled = false; fovCircle.Color = Color3.new(1, 1, 1); fovCircle.Visible = false

for i, v in getgc() do
    if typeof(v) == "function" and not iscclosure(v) then
        local consts = debug.getconstants(v)
        if consts[1] == "ProjectileSpeed" then createProjectile = v
        elseif debug.info(v, "n") == "updatePlayers" then players = debug.getupvalue(v, 1) end
    end
end

function CalculateBulletDrop(tPos, tVel, cPos, pSpeed, pDrop)
    local tTT = (tPos - cPos).Magnitude / pSpeed
    local pTP = tPos + (Vector3.new(tVel.X * 7, tVel.Y * 2, tVel.Z * 7) * tTT)
    local dP = -pDrop ^ (tTT * pDrop) + 1
    return pTP - Vector3.new(0, dP, 0)
end

if createProjectile then
    local oldCP; oldCP = hookfunction(createProjectile, function(cFrame, weaponInfo, isLocal, p63, p64)
        if isLocal and settings.combat_SilentAim then
            local target = nil; local cD = math.huge
            local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
            for _, p in pairs(players) do
                if p.model and p.model:FindFirstChild("Head") then
                    local sPos, on = camera:WorldToViewportPoint(p.model.Head.Position)
                    if sPos.Z > 0 then
                        local d2 = (center - Vector2.new(sPos.X, sPos.Y)).Magnitude
                        if d2 < settings.combat_FovSize and d2 < cD then cD = d2; target = p end
                    end
                end
            end
            if target and table.find(validGuns, tostring(weaponInfo.type)) then
                cFrame = CFrame.new(cFrame.Position, CalculateBulletDrop(target.model.Head.Position, target.velocityVector or Vector3.zero, cFrame.Position, weaponInfo.ProjectileSpeed, weaponInfo.ProjectileDrop or 0))
            end
        end
        return oldCP(cFrame, weaponInfo, isLocal, p63, p64)
    end)
end

-- [[ 5. HELPERS ]]
local function GetPlayerWeapon(char)
    for _, v in pairs(char:GetChildren()) do if v:IsA("Model") and v:GetAttribute("name") then return tostring(v:GetAttribute("name")) end end
    return "None"
end

local function GetArmor(char)
    local f = char:FindFirstChild("Armor")
    if not f then return "None" end
    local items = {}
    for _, v in pairs(f:GetChildren()) do table.insert(items, v.Name) end
    return #items > 0 and table.concat(items, ", ") or "None"
end

local function IsSleeping(char)
    local anim = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("AnimationController")
    if not anim then return false end
    for _, track in pairs(anim:GetPlayingAnimationTracks()) do if track.Animation.AnimationId == "rbxassetid://13280887764" then return true end end
    return false
end

-- [[ 6. UI RESTORED (EVERY TAB) ]]
local espTab = DrRayLibrary.newTab("Visuals", "rbxassetid://6020453174")
local combatTab = DrRayLibrary.newTab("Combat", "rbxassetid://6020453174")
local miscTab = DrRayLibrary.newTab("Misc", "rbxassetid://6020453174")
local oreTab = DrRayLibrary.newTab("Ores", "rbxassetid://6020453174")

espTab.newToggle("Enable ESP", "Master", settings.esp_Enabled, function(v) settings.esp_Enabled = v end)
espTab.newToggle("Box", "2D", settings.esp_Box, function(v) settings.esp_Box = v end)
espTab.newToggle("Skeleton", "Joints", settings.esp_Skeleton, function(v) settings.esp_Skeleton = v end)
espTab.newToggle("Tracer", "Snaplines", settings.esp_Tracer, function(v) settings.esp_Tracer = v end)
espTab.newToggle("Name", "Players", settings.esp_Name, function(v) settings.esp_Name = v end)
espTab.newToggle("Distance", "Meters", settings.esp_Distance, function(v) settings.esp_Distance = v end)
espTab.newToggle("Weapon", "Held Item", settings.esp_Weapon, function(v) settings.esp_Weapon = v end)
espTab.newToggle("Armor", "Gear", settings.esp_Armor, function(v) settings.esp_Armor = v end)
espTab.newToggle("No Bot", "Hide Shylou", settings.esp_NoBot, function(v) settings.esp_NoBot = v end)
espTab.newToggle("Ignore Sleepers", "Filter", settings.esp_SleepCheck, function(v) settings.esp_SleepCheck = v end)

combatTab.newToggle("Silent Aim", "Bullet Predict", settings.combat_SilentAim, function(v) settings.combat_SilentAim = v end)
combatTab.newSlider("FOV Size", "Radius", 800, true, function(v) settings.combat_FovSize = v end)
combatTab.newToggle("Show FOV", "Circle", settings.combat_ShowFOV, function(v) settings.combat_ShowFOV = v end)
combatTab.newToggle("Hitbox Expander", "Modify", settings.combat_HitboxEnabled, function(v) settings.combat_HitboxEnabled = v end)
combatTab.newSlider("Hitbox Size", "Radius", 30, true, function(v) settings.combat_HitboxSize = v end)

miscTab.newToggle("Armor Inspector", "Prox UI", settings.misc_ArmorInspector, function(v) settings.misc_ArmorInspector = v end)
miscTab.newToggle("Crosshair Dot", "Screen Center", settings.misc_DotCrosshair, function(v) settings.misc_DotCrosshair = v end)

oreTab.newToggle("Enable Ores", "Global", settings.ore_Enabled, function(v) settings.ore_Enabled = v end)
oreTab.newToggle("Stone", "Show", settings.ore_ShowStone, function(v) settings.ore_ShowStone = v end)
oreTab.newToggle("Iron", "Show", settings.ore_ShowIron, function(v) settings.ore_ShowIron = v end)
oreTab.newToggle("Nitrate", "Show", settings.ore_ShowNitrate, function(v) settings.ore_ShowNitrate = v end)
oreTab.newToggle("Ore Chams", "Highlight", settings.ore_Chams, function(v) settings.ore_Chams = v end)

-- [[ 7. MASTER RENDER LOOP ]]
local sGui = Instance.new("ScreenGui", Services.CoreGui); sGui.IgnoreGuiInset = true
Services.RunService.RenderStepped:Connect(function()
    sGui:ClearAllChildren()
    local Center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    fovCircle.Visible = settings.combat_ShowFOV; fovCircle.Radius = settings.combat_FovSize; fovCircle.Position = Center

    if settings.misc_DotCrosshair then DrawingLib.new("Square").create(sGui, Center, 4, 4, Color3.new(1,0,0), Color3.new(1,0,0), 1) end

    local children = Services.Workspace:GetChildren()
    for i = 1, #children do
        local model = children[i]
        
        -- PLAYER LOGIC
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("Head") then
            local hrp = model.HumanoidRootPart
            local sPos, on = camera:WorldToViewportPoint(hrp.Position)
            local tag = model.Head:FindFirstChild("Nametag") and model.Head.Nametag:FindFirstChild("tag")
            local dName = (tag and tag.Text ~= "") and tag.Text or model.Name
            
            if sPos.Z > 0 and settings.esp_Enabled then
                if not (settings.esp_NoBot and dName == "Shylou2644") and not (settings.esp_SleepCheck and IsSleeping(model)) then
                    local dist = (camera.CFrame.Position - hrp.Position).Magnitude
                    if dist <= settings.esp_MaxDistance then
                        local color = Color3.fromHSV((tick() * 0.1) % 1, 0.8, 1)
                        local X, Y = sPos.X, sPos.Y
                        local scale = 1 / (dist * math.tan(math.rad(camera.FieldOfView * 0.5))) * 25
                        local w, h = math.floor(45 * scale), math.floor(72 * scale)

                        if settings.esp_Box then DrawingLib.new("Square").create(sGui, Vector2.new(X, Y), w, h, color, color, 1) end
                        if settings.esp_Tracer then DrawingLib.new("Line").create(sGui, Vector2.new(Center.X, camera.ViewportSize.Y), Vector2.new(X, Y + h/2), color, 1) end
                        if settings.esp_Name then DrawingLib.new("Text").create(sGui, Vector2.new(X, Y - h/2 - 12), dName, color) end
                        if settings.esp_Weapon then DrawingLib.new("Text").create(sGui, Vector2.new(X, Y + h/2 + 15), GetPlayerWeapon(model), color) end
                        if settings.esp_Distance then DrawingLib.new("Text").create(sGui, Vector2.new(X, Y + h/2 + 28), math.floor(dist / 3.5) .. "m", color) end
                        if settings.esp_Armor then 
                            local arm = DrawingLib.new("Text").create(sGui, Vector2.new(X, Y + h/2 + 45), GetArmor(model), color)
                            arm.Size = 24 
                        end
                        if settings.esp_Skeleton then
                            for c, p in pairs(skeleton_order) do
                                local b1, b2 = model:FindFirstChild(c), model:FindFirstChild(p)
                                if b1 and b2 then
                                    local sp1, v1 = camera:WorldToViewportPoint(b1.Position)
                                    local sp2, v2 = camera:WorldToViewportPoint(b2.Position)
                                    if sp1.Z > 0 and sp2.Z > 0 then DrawingLib.new("Line").create(sGui, Vector2.new(sp1.X, sp1.Y), Vector2.new(sp2.X, sp2.Y), color, 1) end
                                end
                            end
                        end
                    end
                end
            end
            if settings.combat_HitboxEnabled then
                local p = model:FindFirstChild(settings.combat_HitPart)
                if p then p.Size = Vector3.new(settings.combat_HitboxSize, settings.combat_HitboxSize, settings.combat_HitboxSize); p.Transparency = 0.6; p.CanCollide = false end
            end

        -- ORE LOGIC
        elseif settings.ore_Enabled then
            local mp = model:FindFirstChildOfClass("MeshPart")
            if mp and mp.MeshId == ore_id.Stone then
                local oName = "Stone"; local oPart = mp
                for _, p in pairs(model:GetChildren()) do
                    if p:IsA("BasePart") then
                        if p.Color == ore_id.NitrateColor then oName = "Nitrate" oPart = p break
                        elseif p.Color == ore_id.IronColor then oName = "Iron" oPart = p break end
                    end
                end
                
                local allowed = (oName == "Stone" and settings.ore_ShowStone) or (oName == "Iron" and settings.ore_ShowIron) or (oName == "Nitrate" and settings.ore_ShowNitrate)
                if allowed then
                    local d = (camera.CFrame.Position - oPart.Position).Magnitude
                    local sP, on = camera:WorldToViewportPoint(oPart.Position)
                    if sP.Z > 0 and d <= settings.ore_MaxDistance then
                        local oCol = (oName == "Iron" and Color3.fromRGB(255,165,0)) or (oName == "Nitrate" and Color3.new(1,1,1)) or Color3.new(0.6,0.6,0.6)
                        DrawingLib.new("Text").create(sGui, Vector2.new(sP.X, sP.Y), oName .. " [" .. math.floor(d/3.5) .. "m]", oCol)
                        if settings.ore_Chams then
                            local h = model:FindFirstChild("OreHighlight") or Instance.new("Highlight", model)
                            h.FillColor = oCol; h.Enabled = true; h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        end
                    end
                end
            end
        end
    end
end)
