local settings = {
    silentAim = {
        Enabled = true,
        HitPart = "Head",
        MaxDistance = 2500,
        TargetSleeping = false,
        TargetScientists = true,
        Fov = {
            Visible = true,
            Radius = 100,
            Color = Color3.fromRGB(255, 255, 255),
            Filled = false
        },
        Snapline = {
            Enabled = true,
            Color = Color3.fromRGB(255, 255, 255)
        },
        Highlight = {
            Enabled = true,
            Color = Color3.fromRGB(255, 255, 255),
            FillTransparency = 1
        }
    },
    esp = {
        Enabled = true,
        Tracer = ture,
